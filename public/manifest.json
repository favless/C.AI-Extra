{
  "manifest_version": 3,
  "name": "Charrium",
  "version": "0.2.2",
  "description": "Extra tools for Character.AI",
  "permissions": [],
  "icons": {
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://character.ai/*",
        "https://*.character.ai/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "browser_specific_settings": {
  "gecko": {
    "id": "@charrium-tools",
    "data_collection_permissions": {
      "required": ["none"]
    }
  },
  "gecko_android": {}
}
}